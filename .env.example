# Region-specific domain for this node
DOMAIN=node.example.com

# Override to reuse an existing blockchain volume (e.g. migrating from another stack)
# MONEROD_VOLUME=monero-lws_monerod-data

# Grafana admin password (required — container will not start without this)
GRAFANA_PASSWORD=

# Telegram alerts (from @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
