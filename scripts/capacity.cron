# Capacity metrics every minute and the weekly digest on Monday at 13:00 UTC
# (see scripts/capacity-metrics.sh and scripts/capacity-report.py).
# The digest line runs each hour from 13:00 to 18:00 UTC. With --if-due, a run
# does nothing when the last digest is less than 6 days old, so a failed run
# tries again an hour later. The output of the digest goes to the journal:
# journalctl -t capacity-report --since -8d
# Installed as /etc/cron.d/monero-node-capacity by setup.sh and the deploy workflow.
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
* * * * * root bash /opt/monero-node/scripts/capacity-metrics.sh >/dev/null 2>&1
0 13-18 * * 1 root python3 /opt/monero-node/scripts/capacity-report.py --if-due 2>&1 | logger -t capacity-report
